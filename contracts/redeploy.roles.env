# Role holders for the Base Sepolia redeploy -- ADDRESSES ONLY, no keys.
# Source this file, then export PRIVATE_KEY yourself in the same terminal:
#
#   set -a; . ./redeploy.roles.env; set +a
#   export PRIVATE_KEY=<deployer key -- your terminal only, never in a file>
#
# OWNER is the governance Safe (1.5.0, threshold 1). The seven operational roles go to
# the simulation identities listed in packages/sim/wallets/keys.map.json, so the
# simulation can act as each of them. None of them is the deployer.

export OWNER_ADDRESS=0x0969B20f1d8a5628613f00fa6aDBE85e715fEf15        # governance Safe
export CURATOR_ADDRESS=0xBDEE4a8B7E23243de2113cfAA5ae6F5622fB5907      # curator
export ALLOCATOR_ADDRESS=0xe10E5ed4f28405f3D65691BF0D35Da3dC81A23D8    # allocator
export SENTINEL_ADDRESS=0xDD66a82A13b62684b23430eB250b61c2F9A9FDF5     # sentinel
export COMMITTEE_ADDRESS=0x4dA5dAa1D1702074aF919A5937d0e00E0DCaF555    # committee
export KYC_OPERATOR_ADDRESS=0xe6b36f7Fcfb497714006B22e938F150CbeC97cf0 # kyc-operator
export ORACLE_ADDRESS=0x899b0840Da6da6356a05b2Da122A79F54CFbFecd       # oracle-node
export CEDANT_ADDRESS=0xbF0b13e1319857f0f537bF024125B5e525fFce4D       # cedant-1

# Settlement asset: Circle's USDC on Base Sepolia, not the staging MockUSDC.
export USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Governance phase 1 (contracts/REDEPLOY_RUNBOOK.md, section 3)
export SAFE_ADDRESS=0x0969B20f1d8a5628613f00fa6aDBE85e715fEf15
export EXECUTOR_ADDRESS=0x0969B20f1d8a5628613f00fa6aDBE85e715fEf15
export MIN_DELAY=3600      # 1 hour, the timelock floor: right for a testnet; governance can raise it later
